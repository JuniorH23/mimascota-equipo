# Copy to C:\mimascota\config\db.env and fill secrets locally.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mimascota
DB_USER=mimascota_backup
DB_PASS=
BACKUP_SSH_HOST=your-vm-host-or-ip
BACKUP_SSH_USER=respaldo
BACKUP_REMOTE_ROOT=/var/backups/mimascota
BACKUP_SSH_KEY_PATH=C:\Users\your-user\.ssh\mimascota_respaldo
MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
MYSQL_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
