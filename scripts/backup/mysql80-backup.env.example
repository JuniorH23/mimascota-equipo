# Copy to C:\mimascota\config\mysql80-backup.env and fill in locally.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mimascota
DB_USER=mimascota_backup
DB_PASS=
MYSQL_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
SSH_PATH=C:\Windows\System32\OpenSSH\ssh.exe
SCP_PATH=C:\Windows\System32\OpenSSH\scp.exe
BACKUP_SSH_HOST=vm.example.com
BACKUP_SSH_USER=respaldo
BACKUP_SSH_KEY_PATH=C:\Users\USUARIO\.ssh\mimascota_respaldo
BACKUP_KNOWN_HOSTS_PATH=C:\mimascota\config\ssh_known_hosts
BACKUP_REMOTE_ROOT=/var/backups/mimascota
